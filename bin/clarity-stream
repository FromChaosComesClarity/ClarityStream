#!/usr/bin/env node
'use strict';
// Headless entry point. The whole engine is usable without the Electron UI,
// which is deliberate: a host doctor you cannot run over SSH is no use on a
// machine that is showing a black screen.

const { probe } = require('../packages/core/probe');
const { diagnose } = require('../packages/core/diagnose');
const { buildEdid } = require('../packages/core/edid');
const { planAddParams, detect: detectBootloader } = require('../packages/core/bootloader');
const { planArm, planDisarm, candidates, verifyArmed, restoreMonitorsCommands, toHelperPlan } = require('../packages/core/phantom');
const verify = require('../packages/core/verify');
const { applyAll, needsRestart, restartUserService, isPrivileged } = require('../packages/core/apply');
const pathMod3 = require('node:path');

// Returned by a command that must keep running. The dispatcher calls
// process.exit on whatever a command returns, which killed the watcher the
// instant it finished setting itself up: systemd saw a clean exit and marked
// the unit inactive while the phantom sat where it had drifted.
const KEEP_ALIVE = Symbol('keep-alive');

const C = process.stdout.isTTY
  ? { r: '\x1b[31m', y: '\x1b[33m', g: '\x1b[32m', d: '\x1b[2m', b: '\x1b[1m', x: '\x1b[0m' }
  : { r: '', y: '', g: '', d: '', b: '', x: '' };

const MARK = { blocker: `${C.r}x${C.x}`, degraded: `${C.y}!${C.x}`, info: `${C.d}i${C.x}` };
// An unknown is not a failure, whatever severity the fault would carry if it
// were confirmed, so it must not wear the failure's mark.
const UNKNOWN_MARK = `${C.y}?${C.x}`;

function doctor(json) {
  const facts = probe();
  const result = diagnose(facts);
  if (json) {
    process.stdout.write(`${JSON.stringify({ facts, result }, null, 2)}\n`);
    return result.streamable === true ? 0 : (result.streamable === false ? 1 : 2);
  }

  const card = facts.gpus.find((g) => g.connectedCount > 0);
  console.log(`${C.b}Clarity Stream — host doctor${C.x}`);
  console.log(`${C.d}${facts.host}, kernel ${facts.kernel}${C.x}\n`);

  console.log(`${C.b}What was measured${C.x}`);
  for (const g of facts.gpus) {
    const lit = g.connectedCount
      ? g.connectors.filter((c) => c.status === 'connected').map((c) => c.name).join(', ')
      : 'nothing connected';
    console.log(`  ${g.card}  ${String(g.driver).padEnd(8)} ${g.pciId}  render ${g.renderNode ?? '?'}  -> ${lit}`);
  }
  console.log(`  compositor  ${facts.compositor.desktop} ${facts.compositor.hyprVersion ?? ''} on ${facts.compositor.sessionType}`);
  for (const m of facts.compositor.monitors ?? []) {
    console.log(`              ${m.name}  ${m.width}x${m.height}@${Math.round(m.refresh)}  scale ${m.scale}`);
  }
  console.log(`  sunshine    ${facts.sunshine.installed ? `${facts.sunshine.packageVersion ?? 'installed'} at ${facts.sunshine.realBin}` : 'not installed'}`);
  if (facts.sunshine.installed) {
    console.log(`              capabilities: ${facts.sunshine.capabilities ?? 'none'}`);
    console.log(`              service: enabled=${facts.sunshine.unitEnabled} active=${facts.sunshine.unitActive}`);
  }
  console.log(`  moonlight   ${facts.moonlight.installed ? facts.moonlight.packageVersion : 'not installed'}`);
  console.log(`  capture target  ${card ? `${card.card} / ${card.renderNode}` : 'no card drives a display'}`);
  console.log('');

  console.log(`${C.b}Findings${C.x}`);
  if (!result.findings.length) console.log(`  ${C.g}nothing to report${C.x}`);
  for (const f of result.findings) {
    console.log(`  ${f.unknown ? UNKNOWN_MARK : MARK[f.severity]} ${C.b}${f.title}${C.x}  ${C.d}[${f.id}]${C.x}`);
    console.log(`      ${f.evidence}`);
    if (f.detail) console.log(`      ${C.d}${f.detail}${C.x}`);
    if (f.fix && f.fix.kind !== 'none') {
      console.log(`      ${C.d}fix: ${describeFix(f.fix)}${C.x}`);
    }
  }
  console.log('');
  const colour = result.streamable === true ? C.g : (result.streamable === false ? C.r : C.y);
  console.log(`${colour}${result.summary}${C.x}`);
  // 0 streamable, 1 a real blocker, 2 could not tell. A script that treats
  // "could not tell" as "broken" would act on nothing.
  return result.streamable === true ? 0 : (result.streamable === false ? 1 : 2);
}

function describeFix(fix) {
  switch (fix.kind) {
    case 'install-package': return `install ${fix.packages.join(' ')}`;
    case 'sunshine-conf': return Object.entries(fix.changes).map(([k, v]) => `${k} = ${v}`).join(', ');
    case 'setcap': return `setcap ${fix.caps} ${fix.path}`;
    case 'user-service': return `systemctl --user enable --now ${fix.unit}`;
    case 'choose-output': return `pin output_name to one of ${fix.candidates.join(', ')}`;
    case 'arm-phantom': return `force a connector on ${fix.card}: ${fix.candidates.join(' or ')}`;
    case 'park-phantom': return `clarity-stream phantom --park`;
    case 'install-park-service': return `clarity-stream phantom --install-service`;
    case 'open-ports': return `open ${fix.ports.map((p) => `${p.port}/${p.proto}`).join(', ')} in ${fix.firewall}`;
    case 'modprobe-conf': return `write "${fix.line}" to ${fix.path}`;
    case 'use-phantom-instead': return 'target a forced connector rather than a headless output';
    default: return fix.kind;
  }
}

function edidCmd(args) {
  const [spec, out] = args;
  const m = /^(\d+)x(\d+)(?:@(\d+(?:\.\d+)?))?$/.exec(spec ?? '');
  if (!m) {
    console.error('usage: clarity-stream edid <WxH[@Hz]> [outfile]');
    return 2;
  }
  const { bytes, timing } = buildEdid({
    width: Number(m[1]), height: Number(m[2]), refresh: m[3] ? Number(m[3]) : 60
  });
  if (out) {
    require('node:fs').writeFileSync(out, bytes);
    console.log(`${bytes.length} bytes -> ${out}`);
  } else {
    process.stdout.write(bytes);
    return 0;
  }
  console.log(`${timing.hActive}x${timing.vActive} @ ${timing.actualRefreshHz.toFixed(3)} Hz, ` +
              `pixel clock ${timing.pixelClockMHz} MHz (CVT reduced blanking)`);
  return 0;
}

function bootCmd() {
  const bl = detectBootloader();
  console.log(`bootloader: ${bl.kind ?? 'unrecognised'}`);
  if (bl.dropinPath) console.log(`drop-in:    ${bl.dropinPath}`);
  if (bl.regenerate) console.log(`regenerate: ${bl.regenerate.join(' ')}`);
  if (bl.usesUki !== undefined) console.log(`uki:        ${bl.usesUki}`);
  const plan = planAddParams(['drm.edid_firmware=DP-3:edid/clarity-stream-DP-3.bin', 'video=DP-3:e']);
  console.log(`\nplan ok: ${plan.ok}${plan.alreadyActive ? ' (already active)' : ''}`);
  for (const s of plan.steps ?? []) {
    console.log(s.kind === 'run' ? `  run       ${s.argv.join(' ')}` : `  ${s.kind} ${s.path}`);
  }
  return 0;
}

function fixCmd(rest) {
  const doIt = rest.includes('--apply');
  const outputIdx = rest.indexOf('--output');
  const outputName = outputIdx !== -1 ? rest[outputIdx + 1] : undefined;
  const noService = rest.includes('--no-service');

  const facts = probe();
  const result = diagnose(facts);

  console.log(`${C.b}Clarity Stream — ${doIt ? 'applying fixes' : 'what would change (dry run)'}${C.x}\n`);
  if (!result.findings.length) {
    console.log(`${C.g}Nothing to fix.${C.x}`);
    return 0;
  }

  let out;
  try {
    out = applyAll(facts, result, { outputName, dryRun: !doIt, startService: !noService });
  } catch (err) {
    console.error(`${C.r}${err.message}${C.x}`);
    return 2;
  }

  for (const d of out.done) {
    if (d.kind === 'sunshine-conf') {
      console.log(`${C.b}${facts.sunshine.confPath}${C.x}${d.created ? `  ${C.d}(created)${C.x}` : ''}`);
      for (const a of d.applied) {
        const mark = a.action === 'unchanged' ? C.d + '=' + C.x : C.g + (a.action === 'added' ? '+' : '~') + C.x;
        const from = a.from === null ? '' : ` ${C.d}(was ${a.from})${C.x}`;
        console.log(`  ${mark} ${a.key} = ${a.to}${from}`);
      }
    } else if (d.kind === 'user-service') {
      const ok = d.dryRun ? `${C.d}would enable and start${C.x}` : (d.ok ? `${C.g}${d.detail}${C.x}` : `${C.r}${d.detail}${C.x}`);
      console.log(`${C.b}${d.unit}${C.x}  ${ok}`);
    }
  }

  if (out.deferred.length) {
    console.log(`\n${C.y}Needs root, so not done here:${C.x}`);
    for (const d of out.deferred) {
      console.log(`  ${d.title}  ${C.d}[${d.id}]${C.x}`);
      console.log(`      ${describeFix(d.fix)}`);
    }
  }

  if (!doIt) {
    console.log(`\n${C.d}Nothing was changed. Re-run with --apply.${C.x}`);
    return 0;
  }

  // A config Sunshine has not re-read is a config that has not taken effect.
  if (needsRestart(out) && facts.sunshine.unitFound) {
    const already = out.done.some((d) => d.kind === 'user-service' && d.ok);
    if (!already) {
      const r = restartUserService(facts.sunshine.unitName);
      console.log(`\n${facts.sunshine.unitName}  ${r.ok ? C.g + 'restarted so the new config is read' + C.x : C.r + r.detail + C.x}`);
    }
  }
  console.log(`\n${C.d}Now prove it: clarity-stream verify${C.x}`);
  return 0;
}

function appsCmd(rest) {
  const apply = rest.includes('--apply');
  const prune = rest.includes('--prune-stock');
  const sunshineApps = require('../packages/core/sunshine-apps');
  const phantomScript = require('../packages/core/phantom-script');
  const { enumerateOutputs } = require('../packages/core/outputs');
  const fsMod = require('node:fs');
  const pathMod2 = require('node:path');

  const facts = probe();
  const appsPath = facts.sunshine.appsPath;
  let doc;
  try { doc = sunshineApps.read(appsPath); }
  catch (err) { console.error(`${C.r}${err.message}${C.x}`); return 1; }

  console.log(`${C.b}Clarity Stream — Moonlight app list${C.x}`);
  console.log(`${C.d}${appsPath}${C.x}\n`);

  const settings = require('../packages/core/settings').read();
  const streamDisplay = require('../packages/core/stream-display');
  let scriptPath = null;
  if (settings.strategy === 'resize') {
    scriptPath = streamDisplay.SCRIPT_PATH;
    if (apply) streamDisplay.installScript({ cliPath: require('../packages/core/paths').cliPath() });
    console.log(`  resize     the streamed monitor follows the client's resolution`);
    console.log(`  ${C.d}set when a session starts, put back when it ends${C.x}\n`);
  }
  const phantom = settings.strategy === 'phantom' && enumerateOutputs(facts).find((o) => o.isPhantom);
  if (phantom) {
    const mon = phantom.monitor;
    const opts = {
      connector: phantom.connector,
      // When the phantom is switched off it is absent from hyprctl, so fall
      // back to the mode its EDID prefers rather than reporting nothing.
      // probe.js normalises hyprctl's refreshRate to `refresh`; reading the
      // raw hyprctl name here threw a TypeError and aborted the whole write.
      mode: mon ? `${mon.width}x${mon.height}@${Number(mon.refresh).toFixed(2)}` : `${phantom.preferredMode ?? '1920x1080'}@60`,
      position: mon ? `${mon.x}x${mon.y}` : 'auto',
      scale: mon ? mon.scale : 1
    };
    // The phantom is NOT cycled around a stream. Sunshine resolves
    // output_name when the service starts, not when a session begins, so a
    // phantom that is down at that moment makes every launch fail with
    // "Couldn't find monitor [2]" and a 503 to the client, before any
    // prep-cmd gets the chance to run. Measured. It stays up, parked out of
    // reach, holding a workspace of its own.
    scriptPath = null;
    if (apply) phantomScript.install(opts);  // kept for manual use and teardown
    console.log(`  phantom    ${phantom.connector} at ${opts.mode}`);
    console.log(`  ${C.d}stays up: Sunshine binds output_name at service start, so a${C.x}`);
    console.log(`  ${C.d}phantom that is down then makes every launch fail${C.x}\n`);
  } else if (settings.strategy === 'phantom') {
    console.log(`  ${C.y}no phantom armed; entries will stream whatever output_name points at${C.x}\n`);
  } else if (settings.strategy === 'none') {
    console.log(`  ${C.d}entries stream the monitor as it is; the client scales${C.x}\n`);
  }

  const clarityApp = require('../packages/core/clarity-app');
  const found = clarityApp.find();
  const entries = [];
  if (found.found) {
    console.log(`  Clarity    ${found.path} ${C.d}(${found.via})${C.x}`);
    entries.push(sunshineApps.buildEntry({
      name: 'Clarity Couch Mode',
      cmd: clarityApp.couchCommand(found.path),
      prepScript: scriptPath
    }));
  } else {
    console.log(`  ${C.y}Clarity.AppImage not found, so no Couch Mode tile.${C.x}`);
    console.log(`  ${C.d}looked in: ${found.tried.slice(0, 4).join(', ')}${C.x}`);
  }

  const stale = clarityApp.staleDesktopEntries();
  for (const s2 of stale) {
    console.log(`  ${C.y}note${C.x} ${pathMod2.basename(s2.file)} points at ${s2.target}, which is not there.`);
  }
  entries.push(sunshineApps.buildEntry({ name: 'Clarity Desktop', prepScript: scriptPath }));

  const results = entries.map((e) => sunshineApps.upsert(doc, e));
  for (const r of results) {
    const mark = r.action === 'unchanged' ? `${C.d}=${C.x}` : `${C.g}${r.action === 'added' ? '+' : '~'}${C.x}`;
    console.log(`  ${mark} ${r.name}`);
  }

  const stock = sunshineApps.stockPresent(doc);
  if (stock.length) {
    console.log(`\n  ${C.d}Sunshine's own entries, left alone:${C.x}`);
    for (const s2 of stock) {
      console.log(`    ${s2.name}${s2.brokenOnWayland ? `  ${C.y}(drives xrandr, which does nothing on Wayland)${C.x}` : ''}`);
    }
    if (prune) {
      const removed = sunshineApps.pruneStock(doc);
      console.log(`  ${C.y}removing: ${removed.join(', ')}${C.x}`);
    } else {
      console.log(`    ${C.d}--prune-stock removes them${C.x}`);
    }
  }

  if (!apply) {
    console.log(`\n${C.d}Nothing was written. Re-run with --apply.${C.x}`);
    return 0;
  }
  sunshineApps.write(appsPath, doc);
  console.log(`\n${C.g}Written.${C.x} ${C.d}previous kept as ${appsPath}.clarity-stream.bak${C.x}`);
  if (facts.sunshine.unitFound) {
    const r = restartUserService(facts.sunshine.unitName);
    console.log(`${facts.sunshine.unitName}  ${r.ok ? C.g + r.detail + C.x : C.r + r.detail + C.x}`);
  }
  return 0;
}

// Called by Sunshine around a session, through the small shell script in
// ~/.local/share/clarity-stream. Everything that decides anything lives here
// rather than in that script.
function streamDisplayCmd(rest) {
  const sd = require('../packages/core/stream-display');
  const hypr = require('../packages/core/hypr');
  const { enumerateOutputs } = require('../packages/core/outputs');

  const action = rest.find((a) => !a.startsWith('--'));
  const dry = rest.includes('--dry-run');
  const num = (flag, fallback) => {
    const i = rest.indexOf(flag);
    return i === -1 ? fallback : Number(rest[i + 1]) || fallback;
  };

  const stamp = () => new Date().toISOString().replace('T', ' ').slice(0, 19);
  const say = (m) => console.log(`${stamp()}  ${m}`);

  const monitors = hypr.monitors();
  if (!monitors) { say('the compositor did not answer; leaving the display alone'); return 1; }

  if (action === 'stop') {
    const saved = sd.readSaved();
    if (!saved) { say('nothing to restore'); return 0; }
    const sel = saved.description ? `desc:${saved.description}` : saved.connector;
    const mode = `${saved.width}x${saved.height}@${Number(saved.refresh).toFixed(5)}`;
    say(`restoring ${saved.connector} to ${mode}${dry ? ' (dry run)' : ''}`);
    if (!dry) {
      hypr.evalLua(`hl.monitor(${hypr.luaTable({
        output: sel, mode, position: saved.position, scale: saved.scale, disabled: false
      })})`);
      sd.clearState();
    }
    return 0;
  }

  if (action !== 'start') {
    console.error('usage: clarity-stream stream-display start|stop [--width N --height N --fps N]');
    return 2;
  }

  const width = num('--width', 0);
  const height = num('--height', 0);
  const fps = num('--fps', 60);
  if (!width || !height) { say('the client did not say what size it wanted; leaving the display alone'); return 0; }

  // Which monitor gets streamed: whatever Sunshine is pointed at, so the
  // resize and the capture can never disagree about the target.
  const facts = probe();
  const outs = enumerateOutputs(facts);
  const idx = facts.sunshine.confRaw?.match(/^\s*output_name\s*=\s*(\d+)/m)?.[1];
  const target = (idx !== undefined && outs.find((o) => String(o.index) === idx)) ?? outs.find((o) => o.monitor);
  if (!target?.monitor) { say('no streamable monitor; leaving the display alone'); return 1; }

  const live = monitors.find((m) => m.name === target.connector);
  if (!live) { say(`${target.connector} is not being driven; leaving it alone`); return 1; }

  const want = sd.chooseMode(live.availableModes, { width, height, fps });
  if (!want) {
    // Moving the desktop to "nearly" the requested size still makes Sunshine
    // scale, and has disturbed everything for nothing.
    say(`${live.name} has no ${width}x${height} mode; leaving it alone and letting Sunshine scale`);
    return 0;
  }
  if (live.width === want.width && live.height === want.height &&
      Math.abs(live.refreshRate - want.refresh) < 0.5) {
    say(`${live.name} is already ${want.raw}; nothing to change`);
    return 0;
  }

  // Recorded before anything changes, so the undo has something to restore
  // even if the next step fails.
  const state = {
    connector: live.name,
    description: live.description || null,
    width: live.width, height: live.height, refresh: live.refreshRate,
    position: `${live.x}x${live.y}`, scale: live.scale,
    at: new Date().toISOString()
  };
  say(`${live.name}: ${live.width}x${live.height}@${live.refreshRate.toFixed(2)} -> ${want.raw}${dry ? ' (dry run)' : ''}`);
  if (dry) return 0;

  sd.saveState(state);
  const sel = state.description ? `desc:${state.description}` : state.connector;
  const r = hypr.evalLua(`hl.monitor(${hypr.luaTable({
    output: sel, mode: `${want.width}x${want.height}@${want.refresh.toFixed(5)}`,
    position: state.position, scale: state.scale, disabled: false
  })})`);
  if (!r.ok) {
    say(`the compositor refused: ${r.output}`);
    // The mode did not take, so there is nothing to undo, and leaving a state
    // file behind would make the host app offer to restore something that was
    // never changed.
    sd.clearState();
    return 1;
  }
  return 0;
}

function firewallCmd(rest) {
  const firewall = require('../packages/core/firewall');
  const paths = require('../packages/core/paths');
  const st = firewall.detect();

  console.log(`${C.b}Clarity Stream — reachability${C.x}\n`);
  if (!st.present) {
    console.log(`  ${C.g}No firewall is running, so nothing here is blocking the stream ports.${C.x}`);
    return 0;
  }
  console.log(`  firewall   ${st.kind}${st.policy ? `, default input ${st.policy}` : ''}`);
  if (st.unknown) {
    console.log(`  ${C.y}Its rules could not be read from here, so this cannot say either way.${C.x}`);
    console.log(`  ${C.d}Sunshine needs TCP 47984, 47989, 48010 and UDP 47998-48000, 48002, 48010.${C.x}`);
    return 2;
  }
  if (!st.missing.length) {
    console.log(`  ${C.g}All of Sunshine's ports are already allowed.${C.x}`);
    return 0;
  }
  console.log(`  missing    ${st.missing.map((m) => `${m.port}/${m.proto}`).join(', ')}`);
  console.log(`\n  ${C.d}Every check on this machine passes regardless, because they all go over${C.x}`);
  console.log(`  ${C.d}loopback. From another machine the host simply does not answer.${C.x}\n`);

  if (!rest.includes('--open')) {
    console.log(`${C.d}Run with --open to write the plan that fixes it,${C.x}`);
    console.log(`${C.d}or --open --lan to allow only this network rather than every network.${C.x}`);
    return 1;
  }

  // On a laptop that joins other networks, opening the streaming ports to all
  // of them is the wrong default. Raised by the session on the AMD machine.
  const scope = rest.includes('--lan') ? firewall.lanCidr() : null;
  if (rest.includes('--lan') && !scope) {
    console.log(`${C.y}Could not work out this machine's network, so the plan opens the ports everywhere.${C.x}`);
  }

  const fs = require('node:fs');
  const os = require('node:os');
  const dir = pathMod3.join(os.homedir(), '.cache', 'clarity-stream');
  fs.mkdirSync(dir, { recursive: true });
  const planFile = pathMod3.join(dir, 'firewall-plan.json');
  fs.writeFileSync(planFile, JSON.stringify(firewall.planOpen(st, { scope }), null, 2));
  if (scope) console.log(`${C.d}scoped to ${scope}${C.x}`);
  console.log(`${C.b}Plan written to${C.x} ${planFile}`);
  console.log(`${C.b}Apply it:${C.x}`);
  console.log(`  ${paths.helperCommand(planFile)}`);
  return 0;
}

function verifyCmd(rest) {
  const facts = probe();
  const card = facts.gpus.find((g) => g.connectedCount > 0);
  const output = rest.find((a) => !a.startsWith('-')) ??
    (facts.compositor.monitors ?? []).find((m) => m.focused)?.name;

  console.log(`${C.b}Clarity Stream — capture verification${C.x}\n`);

  // Two readings, a moment apart. One frame cannot tell a stream from a
  // still, and a still is exactly what a loading screen looks like.
  const g = verify.verifyDesktopIsDrawing(output);
  const g2 = verify.verifyDesktopIsDrawing(output);
  if (!g.ok) {
    console.log(`  ${C.y}compositor readback  could not run: ${g.reason}${C.x}`);
  } else {
    const cmp = verify.compareFrames(g, g2);
    const colour = cmp.verdict === 'live' ? C.g : (cmp.verdict === 'black' ? C.r : C.y);
    console.log(`  compositor readback  ${colour}${cmp.verdict}${C.x}  ${C.d}(${output}: mean ${g.mean}, peak ${g.max}, stddev ${g.stddev})${C.x}`);
    console.log(`  ${C.d}${cmp.text}${C.x}`);
    console.log(`  ${C.d}grim via wlr-screencopy. Proves the desktop is drawing, nothing more.${C.x}`);
  }

  // The trap that makes a working host look broken.
  const streamed = (() => {
    const { enumerateOutputs } = require('../packages/core/outputs');
    const idx = facts.sunshine.confRaw?.match(/^\s*output_name\s*=\s*(\d+)/m)?.[1];
    if (idx === undefined) return null;
    return enumerateOutputs(facts).find((o) => String(o.index) === idx)?.connector ?? null;
  })();
  if (streamed) {
    console.log(`\n  ${C.b}streaming${C.x}  ${streamed}`);
    const warn = verify.loopbackWarning({ streamedConnector: streamed, clientOnConnector: streamed });
    if (warn) {
      console.log(`  ${C.y}If you test with a client on ${streamed} itself, expect black:${C.x}`);
      console.log(`  ${C.d}${warn.text}${C.x}`);
    }
  }

  console.log('');
  if (!card) {
    console.log(`  ${C.r}No GPU drives a display, so there is nothing to capture.${C.x}`);
    return 1;
  }

  // The measurement that actually settles it needs CAP_SYS_ADMIN, the same
  // privilege Sunshine needs, so we show the command rather than escalate.
  const out = '/tmp/clarity-stream-kms-check.png';
  const cmdline = verify.kmsgrabCommand(card.devNode, out);
  console.log(`  ${C.b}DRM scanout readback${C.x}  ${C.d}needs CAP_SYS_ADMIN, same as Sunshine${C.x}`);
  console.log(`      sudo ${cmdline.join(' ')}`);
  console.log(`      then: node bin/clarity-stream measure ${out}`);
  console.log(`  ${C.d}This is the path 'capture = kms' uses. A live frame here is the only${C.x}`);
  console.log(`  ${C.d}real evidence that the stream will not be black.${C.x}`);
  return 0;
}

function measureCmd(rest) {
  const file = rest[0];
  if (!file) { console.error('usage: clarity-stream measure <image>'); return 2; }
  const m = verify.measureImage(file);
  if (!m.ok) { console.error(m.reason); return 1; }
  const colour = m.verdict === 'live' ? C.g : C.r;
  console.log(`${file}: ${colour}${m.verdict}${C.x}  mean ${m.mean}  peak ${m.max}  min ${m.min}  stddev ${m.stddev}`);
  if (m.isBlack) {
    console.log(`${C.r}Nothing in this frame is brighter than ${verify.BLACK_CEILING}/255. This is a black capture.${C.x}`);
  }
  return m.isBlack ? 1 : 0;
}

function phantomCmd(rest) {
  const hypr = require('../packages/core/hypr');
  const phantomService = require('../packages/core/phantom-service');
  const { enumerateOutputs } = require('../packages/core/outputs');

  // --park / --unpark / --install-service act on a phantom that already
  // exists, so they run before the planning path below.
  if (rest.includes('--park') || rest.includes('--unpark') ||
      rest.includes('--install-service') || rest.includes('--watch')) {
    const waitIdx = rest.indexOf('--wait');
    const waitSecs = waitIdx === -1 ? 0 : Number(rest[waitIdx + 1] || 30);

    // graphical-session.target can be reached before the compositor answers,
    // so wait rather than fail at login.
    const deadline = Date.now() + waitSecs * 1000;
    let mons = hypr.monitors();
    while (!mons && Date.now() < deadline) {
      try { require('node:child_process').execFileSync('sleep', ['1']); } catch { /* ignore */ }
      mons = hypr.monitors();
    }
    if (!mons) { console.error('Hyprland did not answer; nothing to do.'); return 1; }

    const facts2 = probe();
    const ph = enumerateOutputs(facts2).find((o) => o.isPhantom);
    if (!ph) { console.error('No phantom display is armed.'); return 1; }

    if (rest.includes('--install-service')) {
      const r = phantomService.install({
        nodePath: process.execPath,
        cliPath: require('../packages/core/paths').cliPath(),
        sunshineUnit: facts2.sunshine.unitName
      });
      console.log(`${C.b}${r.path}${C.x}`);
      console.log(`  daemon-reload ${r.reloaded ? C.g + 'ok' + C.x : C.r + 'failed' + C.x}`);
      console.log(`  enabled       ${r.enabled ? C.g + 'yes' + C.x : C.r + (r.detail || 'failed') + C.x}`);
      console.log(`${C.d}It parks ${ph.connector} at login, before ${facts2.sunshine.unitName}.${C.x}`);
      return r.enabled ? 0 : 1;
    }

    if (rest.includes('--unpark')) {
      const r = hypr.disable(ph.connector);
      console.log(`${ph.connector} ${r.present ? C.r + 'still up' + C.x : C.g + 'taken down' + C.x}`);
      return r.present ? 1 : 0;
    }

    const mode = `${ph.preferredMode ?? '1920x1080'}@60`;

    if (rest.includes('--watch')) {
      const stamp = () => new Date().toISOString().replace('T', ' ').slice(0, 19);
      const say = (m) => console.log(`${stamp()}  ${m}`);

      const doPark = (why) => {
        const res = hypr.park(ph.connector, { mode });
        say(`${why}: ${res.ok ? `parked at ${res.position}, workspace ${res.workspace}` : 'park failed'}` +
            (res.strandedWorkspaces?.length ? `, still holding ${res.strandedWorkspaces.join(',')}` : ''));
        return res;
      };

      const first = doPark('start');
      let expected = first.position;

      // Hyprland emits several events for one reconfigure, so a reload is
      // coalesced rather than parked five times in a row.
      let timer = null;
      const onChange = () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          const now = (hypr.monitors() ?? []).find((m) => m.name === ph.connector);
          const held = hypr.workspaceOn(ph.connector).map((w) => w.id);
          const drifted = !now
            || `${now.x}x${now.y}` !== expected
            || held.some((id) => id !== 11);
          if (!drifted) return;
          const res = doPark(now ? 'drifted back' : 'went missing');
          if (res.ok) expected = res.position;
        }, 800);
      };

      hypr.watchMonitorEvents(onChange, { log: (m) => say(m) });
      say(`watching ${hypr.eventSocketPath() ?? 'no event socket'}`);

      for (const sig of ['SIGINT', 'SIGTERM']) {
        process.on(sig, () => { say(`${sig}, stopping`); process.exit(0); });
      }
      return KEEP_ALIVE;
    }

    const r = hypr.park(ph.connector, { mode });
    console.log(`${C.b}${ph.connector}${C.x} parked at ${r.position}, workspace ${r.workspace}`);
    if (r.strandedWorkspaces.length) {
      console.log(`  ${C.y}still holding ${r.strandedWorkspaces.map((w) => `ws${w}`).join(', ')}${C.x}`);
    } else {
      console.log(`  ${C.g}holds only its own workspace; none of yours are stranded${C.x}`);
    }
    return r.ok ? 0 : 1;
  }

  const facts = probe();
  const spec = rest.find((a) => /^\d+x\d+(@\d+)?$/.test(a));
  const connector = rest.find((a) => /^(DP|HDMI)[-A-Z0-9]*$/i.test(a));
  const { card, ranked } = candidates(facts);

  console.log(`${C.b}Clarity Stream — phantom display${C.x}\n`);
  if (!card) { console.log(`${C.r}No GPU drives a display.${C.x}`); return 1; }
  console.log(`  display GPU        ${card.card} (${card.driver})`);
  console.log(`  spare connectors   ${ranked.join(', ') || 'none'}`);
  // Check whichever connector we actually wrote an EDID for, not just the
  // first candidate: once armed, that connector is no longer "spare".
  const target = connector ?? (() => {
    const fsMod = require('node:fs');
    const { FIRMWARE_DIR } = require('../packages/core/phantom');
    try {
      const f = fsMod.readdirSync(FIRMWARE_DIR).find((n) => /^clarity-stream-(.+)\.bin$/.test(n));
      return f ? f.match(/^clarity-stream-(.+)\.bin$/)[1] : ranked[0];
    } catch { return ranked[0]; }
  })();

  const armed = target ? verifyArmed(target) : null;
  if (armed) {
    console.log(`  phantom connector  ${target}`);
    console.log(`  currently armed    ${armed.armed ? C.g + 'yes' + C.x : C.y + 'no' + C.x}  ${C.d}${armed.reason ?? ''}${C.x}`);
    console.log(`  ${C.d}status ${armed.status}, EDID ${armed.edidLength} bytes, matches ours: ${armed.edidMatches}${C.x}`);
    if (armed.modes?.length) {
      console.log(`  modes offered      ${armed.modes.join(', ')}`);
    }
  }
  console.log('');

  if (!spec) {
    console.log(`${C.d}Pass a resolution to see the plan, e.g. clarity-stream phantom 1920x1080@60${C.x}`);
    return 0;
  }
  const m = /^(\d+)x(\d+)(?:@(\d+))?$/.exec(spec);
  const plan = planArm(facts, {
    connector, width: Number(m[1]), height: Number(m[2]), refresh: m[3] ? Number(m[3]) : 60
  });
  if (!plan.ok) { console.log(`${C.r}${plan.reason}${C.x}`); return 1; }

  console.log(`${C.b}Plan: force ${plan.connector} on ${plan.card} as ${m[1]}x${m[2]}@${m[3] ?? 60}${C.x}`);
  console.log(`  timing   ${plan.timing.hActive}x${plan.timing.vActive} @ ${plan.timing.actualRefreshHz.toFixed(3)} Hz, ` +
              `${plan.timing.pixelClockMHz} MHz pixel clock (CVT reduced blanking)`);
  console.log(`  modes    ${plan.advertised.map((a) => `${a.width}x${a.height}`).join(', ')}`);
  console.log(`  ${C.d}all selectable at runtime; only the EDID itself needs a reboot${C.x}`);
  console.log(`  bootloader ${plan.bootloader?.kind ?? 'unknown'}${plan.bootloader?.usesUki ? ' (UKI)' : ''}`);
  console.log(`  kernel params  ${plan.kernelParams.join(' ')}`);
  console.log('');
  console.log(`${C.b}Steps${C.x}`);
  for (const s of plan.steps) {
    if (s.kind === 'run') console.log(`  run          ${s.argv.join(' ')}`);
    else if (s.kind === 'write-file') console.log(`  write        ${s.path}${s.binary ? ` (${s.contents.length} bytes)` : ''}`);
    else console.log(`  ${s.kind}  ${s.path}`);
  }
  console.log('');

  if (rest.includes('--arm')) {
    const fs = require('node:fs');
    const os = require('node:os');
    const pathMod = require('node:path');
    const dir = pathMod.join(os.homedir(), '.cache', 'clarity-stream');
    fs.mkdirSync(dir, { recursive: true });
    const planFile = pathMod.join(dir, 'phantom-plan.json');
    fs.writeFileSync(planFile, JSON.stringify(
      toHelperPlan(plan, `Arm the phantom display on ${plan.connector} (${m[1]}x${m[2]})`), null, 2));
    const paths = require('../packages/core/paths');
    const apply = paths.helperCommand(planFile);
    console.log(`${C.b}Plan written to${C.x} ${planFile}`);
    console.log(`${C.d}Check it without changing anything:${C.x}`);
    console.log(`  ${apply.replace(/^sudo /, '')} --dry-run`);
    console.log(`${C.b}Then apply it:${C.x}`);
    console.log(`  ${apply}`);
    console.log('');
  }

  console.log(`${C.y}A reboot is required: NVIDIA does not hot-reload a firmware EDID.${C.x}`);
  if (plan.monitorStateAtRisk) {
    console.log(`${C.y}Adding an output makes Hyprland re-apply monitors.lua, discarding runtime${C.x}`);
    console.log(`${C.y}monitor state. These restore the current state afterwards:${C.x}`);
    for (const c of restoreMonitorsCommands(plan.monitorSnapshot)) {
      console.log(`  ${c[0]} ${c[1]} '${c[2]}'`);
    }
  }
  return 0;
}

const [cmd, ...rest] = process.argv.slice(2);
let code = 0;
switch (cmd) {
  case 'doctor': code = doctor(rest.includes('--json')); break;
  case 'probe': console.log(JSON.stringify(probe(), null, 2)); break;
  case 'edid': code = edidCmd(rest); break;
  case 'boot': code = bootCmd(); break;
  case 'fix': code = fixCmd(rest); break;
  case 'apps': code = appsCmd(rest); break;
  case 'firewall': code = firewallCmd(rest); break;
  case 'stream-display': code = streamDisplayCmd(rest); break;
  case 'verify': code = verifyCmd(rest); break;
  case 'measure': code = measureCmd(rest); break;
  case 'phantom': code = phantomCmd(rest); break;
  default:
    console.log('clarity-stream <command>\n');
    console.log('  doctor [--json]      probe this host and report what would stop a stream');
    console.log('  probe                dump measured facts as JSON');
    console.log('  edid <WxH[@Hz]> [f]  build a phantom display EDID');
    console.log('  fix [--apply]        apply what can be fixed without root');
  console.log('                       [--output NAME] [--no-service]');
  console.log('  apps [--apply]       publish the Moonlight app list [--prune-stock]');
  console.log('  firewall [--open]    can other machines reach this host at all');
  console.log('  stream-display       resize the streamed display for a session');
  console.log('                       start|stop, called by Sunshine around a stream');
  console.log('  verify [output]      measure real pixels, prove the capture is not black');
  console.log('  measure <image>      report whether a captured frame is black');
  console.log('  phantom [WxH[@Hz]]   plan the phantom stream display');
  console.log('                       [--arm] writes a plan for the privileged helper');
  console.log('                       [--park] park it and reserve its workspace');
  console.log('                       [--install-service] park it at every login');
  console.log('  boot                 show how a kernel parameter would be added here');
    code = cmd ? 2 : 0;
}
// A long-running command keeps the event loop alive on its own; exiting here
// would end it before it had done anything.
if (code !== KEEP_ALIVE) process.exit(code);
