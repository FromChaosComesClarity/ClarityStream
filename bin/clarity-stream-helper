#!/usr/bin/env node
'use strict';
// The privileged half, and the only part of Clarity Stream that ever runs as
// root. It takes a plan produced by the engine, checks every step against an
// allowlist, prints exactly what it is about to do, and does only that.
//
// Two things only: open Sunshine's ports on the firewall, and grant the
// Sunshine binary the capability KMS capture needs. It cannot write a file,
// delete a file, or touch the boot path. Nothing it runs is assembled from
// caller input.
//
// The engine cannot ask this to do anything the allowlist does not already
// permit. That is deliberate: the unprivileged side builds plans, and a bug
// there should not become a root exploit here. Paths are resolved and
// compared literally, commands are matched by exact argv, and there is no
// shell anywhere in this file.

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { execFileSync } = require('node:child_process');

// Commands here rebuild an initramfs and a boot entry. Keeping only the last
// line of their output, which is what this did at first, throws away the part
// that says whether the build actually succeeded: a run of `mkinitcpio -P`
// reported "Updated: /boot/limine.conf", which is a hook's message, not
// mkinitcpio's own. Everything goes to a log, and only a summary to the
// terminal.
const LOG_DIR = '/var/log/clarity-stream';
let logFile = null;

function openLog() {
  try {
    fs.mkdirSync(LOG_DIR, { recursive: true, mode: 0o755 });
    logFile = path.join(LOG_DIR, `helper-${new Date().toISOString().replace(/[:.]/g, '-')}.log`);
    fs.writeFileSync(logFile, '', { mode: 0o644 });
  } catch {
    // Not fatal. A helper that refuses to work because it cannot log is worse
    // than one that works and says where the log is not.
    logFile = null;
  }
  return logFile;
}

function log(text) {
  if (!logFile) return;
  try { fs.appendFileSync(logFile, text.endsWith('\n') ? text : `${text}\n`); } catch { /* ignore */ }
}

// Sunshine's documented ports, and only those. 47990 is the web interface and
// is deliberately absent: it is the administrative surface, Moonlight never
// touches it, and Clarity Stream reaches it over loopback.
const STREAM_PORTS = [
  [47984, 'tcp'], [47989, 'tcp'], [48010, 'tcp'],
  [47998, 'udp'], [47999, 'udp'], [48000, 'udp'], [48002, 'udp'], [48010, 'udp']
];

// Commands this helper may run, matched on the whole argv, not a prefix.
// The firewall entries are enumerated rather than pattern-matched, so there
// is no argument a caller can supply that opens a port not on this list.
const RUNNABLE = [
  ...STREAM_PORTS.map(([p, proto]) => ['ufw', 'allow', `${p}/${proto}`]),
  ...STREAM_PORTS.map(([p, proto]) => ['firewall-cmd', '--permanent', `--add-port=${p}/${proto}`]),
  ['firewall-cmd', '--reload']
];

// setcap is allowed only onto a real binary, and only with these capabilities.
const SETCAP_ALLOWED = new Set(['cap_sys_admin,cap_sys_nice+p', 'cap_sys_admin+p']);

// The scoped form cannot be enumerated, because the network and the list of
// ports both vary. It is validated by shape instead, and every port in it has
// to be one of Sunshine's:
//
//   ufw allow from <cidr> to any port <p,p,p> proto tcp|udp
//
// Opening the ports to one network rather than to every network a laptop ever
// joins is the better default, so it is worth supporting properly rather than
// telling people to run it themselves.
function allowedScopedUfw(argv) {
  if (argv.length !== 10) return false;
  const [cmd, allow, from, cidr, to, any, port, ports, proto, family] = argv;
  if (cmd !== 'ufw' || allow !== 'allow' || from !== 'from') return false;
  if (to !== 'to' || any !== 'any' || port !== 'port' || proto !== 'proto') return false;
  if (family !== 'tcp' && family !== 'udp') return false;
  // IPv4 CIDR or IPv6 CIDR, nothing clever.
  if (!/^(\d{1,3}(\.\d{1,3}){3}\/\d{1,2}|[0-9a-fA-F:]+\/\d{1,3})$/.test(cidr)) return false;
  const wanted = new Set(STREAM_PORTS.filter(([, p]) => p === family).map(([n]) => String(n)));
  const list = ports.split(',');
  return list.length > 0 && list.every((p) => wanted.has(p));
}

function allowedRun(argv) {
  if (RUNNABLE.some((a) => a.length === argv.length && a.every((v, i) => v === argv[i]))) return true;
  return allowedScopedUfw(argv);
}

function describe(step) {
  switch (step.kind) {
    case 'run': return `run      ${step.argv.join(' ')}`;
    case 'setcap': return `setcap   ${step.caps} ${step.path}`;
    default: return `UNKNOWN  ${JSON.stringify(step)}`;
  }
}

function validate(step) {
  switch (step.kind) {
    case 'run':
      if (!Array.isArray(step.argv) || !allowedRun(step.argv)) return `refusing to run ${JSON.stringify(step.argv)}`;
      return null;
    case 'setcap':
      if (!SETCAP_ALLOWED.has(step.caps)) return `refusing capabilities ${step.caps}`;
      if (!fs.existsSync(step.path) || !fs.statSync(step.path).isFile()) return `no such binary ${step.path}`;
      return null;
    default:
      return `unknown step kind ${step.kind}`;
  }
}

function run(step) {
  switch (step.kind) {
    case 'run': {
      const out = execFileSync(step.argv[0], step.argv.slice(1), {
        encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 600000
      });
      log(`\n$ ${step.argv.join(' ')}\n${out}`);
      const lines = out.trim().split('\n').filter((l) => l.trim());
      // Surface anything that looks like trouble even on a zero exit status,
      // because mkinitcpio warns and succeeds.
      const warnings = lines.filter((l) => /\b(warning|error|failed|cannot|missing)\b/i.test(l));
      if (warnings.length) {
        return `ok, with ${warnings.length} warning${warnings.length === 1 ? '' : 's'}:\n` +
               warnings.slice(0, 5).map((w) => `      ${w.trim().slice(0, 160)}`).join('\n');
      }
      return `ok (${lines.length} lines logged)`;
    }
    case 'setcap':
      execFileSync('setcap', [step.caps, step.path], { stdio: ['ignore', 'pipe', 'pipe'] });
      return 'capabilities set';
    default:
      throw new Error(`unreachable: ${step.kind}`);
  }
}

const args = process.argv.slice(2);
const planPath = args.find((a) => !a.startsWith('-'));
const dryRun = args.includes('--dry-run');

if (!planPath) {
  console.error('usage: clarity-stream-helper <plan.json> [--dry-run]');
  process.exit(2);
}

let plan;
try {
  plan = JSON.parse(fs.readFileSync(planPath, 'utf8'));
} catch (err) {
  console.error(`could not read the plan: ${err.message}`);
  process.exit(2);
}

const steps = Array.isArray(plan.steps) ? plan.steps : [];
if (!steps.length) {
  console.error('the plan contains no steps');
  process.exit(2);
}

console.log(`Clarity Stream helper${dryRun ? ' (dry run)' : ''}`);
if (plan.description) console.log(`  ${plan.description}`);
console.log('');

// Everything is checked before anything runs. A plan that is partly illegal
// does not get to perform the legal half of itself.
const problems = steps.map(validate).map((p, i) => (p ? `  step ${i + 1}: ${p}` : null)).filter(Boolean);
for (const s of steps) console.log(`  ${describe(s)}`);
console.log('');

if (problems.length) {
  // A plan written by a newer Clarity Stream can legitimately contain steps
  // this helper has never heard of. That is an upgrade, not an attack, and
  // saying "outside the allowlist" sends the reader looking for the wrong
  // thing entirely.
  const mine = (() => {
    // Its OWN package.json first. Looking at the installed copy first makes a
    // helper running from a checkout report the installed version, which is
    // exactly the confusion this message exists to clear up.
    for (const p of [path.join(__dirname, '..', 'package.json'),
                     '/opt/clarity-stream/app/package.json']) {
      try { return JSON.parse(fs.readFileSync(p, 'utf8')).version; } catch { /* next */ }
    }
    return null;
  })();
  const theirs = plan.producedBy?.version ?? null;

  if (theirs && mine && theirs !== mine) {
    console.error(`Refused: this plan was written by Clarity Stream ${theirs}, and this helper is ${mine}.`);
    console.error('The versions have to match. Upgrade, then build the plan again:');
    console.error('  clarity-stream firewall --open     (or re-run the step that produced it)');
    process.exit(1);
  }

  console.error('Refused. The plan asks for something outside the allowlist:');
  for (const p of problems) console.error(p);
  if (!theirs) {
    console.error('\nThe plan does not say which version wrote it, so it may simply predate this helper.');
  }
  process.exit(1);
}

if (dryRun) {
  console.log('Dry run: nothing was changed.');
  process.exit(0);
}

if (process.getuid && process.getuid() !== 0) {
  console.error('This needs root. Run it with sudo.');
  process.exit(1);
}

const lf = openLog();
if (lf) console.log(`  full output: ${lf}\n`);
else console.log(`  (could not open a log in ${LOG_DIR}; output below is a summary only)\n`);
log(`Clarity Stream helper\n${plan.description ?? ''}\n${new Date().toISOString()}\n`);

let failed = false;
for (const [i, step] of steps.entries()) {
  process.stdout.write(`  [${i + 1}/${steps.length}] ${describe(step)} ... `);
  try {
    console.log(run(step));
  } catch (err) {
    console.log('FAILED');
    const detail = (err.stderr ? String(err.stderr) : err.message).trim();
    log(`\nFAILED: ${describe(step)}\n${detail}\n`);
    for (const line of detail.split('\n').slice(0, 6)) console.error(`      ${line}`);
    failed = true;
    break;
  }
}

if (failed) {
  console.error('\nStopped at the first failure. Nothing after it was run.');
  process.exit(1);
}
console.log(`\nDone.${plan.rebootRequired ? ' A reboot is needed for this to take effect.' : ''}`);
if (logFile) console.log(`Full output: ${logFile}`);
