{
  "name": "clarity-stream",
  "version": "0.4.2",
  "description": "Clarity Stream, game streaming from a Linux box that actually works, including on NVIDIA",
  "main": "apps/host/main.js",
  "type": "commonjs",
  "bin": {
    "clarity-stream": "bin/clarity-stream"
  },
  "scripts": {
    "doctor": "node bin/clarity-stream doctor",
    "probe": "node bin/clarity-stream probe",
    "test": "node --test test/",
    "start": "electron .",
    "start:dev": "electron . --dev",
    "start:client": "electron apps/client/main.js",
    "pkg": "node scripts/build-package.mjs"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "electron": "^41.3.0"
  }
}
