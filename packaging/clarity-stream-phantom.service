[Unit]
Description=Clarity Stream, park the phantom stream display
Documentation=https://github.com/FromChaosComesClarity/ClarityStream
After=graphical-session.target
PartOf=graphical-session.target
# Sunshine binds its capture output when it starts, so the phantom has to
# exist and be parked before it does.
Before=app-dev.lizardbyte.app.Sunshine.service

[Service]
# Long-running: parking is runtime state, and anything that makes Hyprland
# re-read its config drops it. This parks once, then watches Hyprland's event
# socket and parks again whenever the phantom moves.
Type=simple
ExecStart=/usr/bin/clarity-stream phantom --watch --wait 30
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
